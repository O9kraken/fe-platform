# Строка подключения из Neon: Dashboard → Connect → Connection string (с ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Любая длинная случайная строка. На Render создаётся автоматически.
JWT_SECRET=замени-на-длинную-случайную-строку-минимум-24-символа

# Администратор создаётся при первом запуске
ADMIN_USERNAME=KRAKER
ADMIN_PASSWORD=придумай-надёжный-пароль

# Наставник (необязательно). Ключ: https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=60

# false — закрыть самостоятельную регистрацию
ALLOW_REGISTRATION=true
